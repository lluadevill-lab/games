{
  "name": "rocket-lite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "tsx tests/physics.test.mjs && tsx tests/controls.test.mjs && tsx tests/arena.test.mjs && tsx tests/settings.test.mjs",
    "test:boot": "npm run build && node tests/boot.test.mjs",
    "test:all": "npm run typecheck && npm run test && npm run test:boot"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
