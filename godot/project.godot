; Engine configuration file.
; Rocket Lite — Godot 4 port of the web Rocket Lite (futebol com carros-foguete).
; Física 1:1 a 120 Hz, baseada em RLBot/RocketSim (ver rocket/MECANICAS.md).

config_version=5

[application]

config/name="Rocket Lite"
config/description="Futebol com carros-foguete — física fiel ao Rocket League a 120 Hz. Port Godot do Rocket Lite (faculdade / Games Lab)."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

